# ==============================================================================
# ⚙️ Application Environment Variables (ตัวอย่างการตั้งค่า Environment)
# ==============================================================================

# 🌐 Application Port (พอร์ตที่ NestJS Server ทำงาน)
PORT=3000

# 🐘 PostgreSQL Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ค่า Default สำหรับ Docker setup ในโปรเจกต์นี้ใช้ Port 5433 (เพื่อไม่ให้ชนกับ Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nestjs_blog?schema=public"

# 🔒 JWT Authentication Configuration (การตั้งค่าความปลอดภัย JWT)
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ⚡ Redis In-Memory Cache Configuration (การตั้งค่าแคช Redis)
# ค่า Default สำหรับ Docker Redis container ในโปรเจกต์นี้ใช้ Port 6379
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
